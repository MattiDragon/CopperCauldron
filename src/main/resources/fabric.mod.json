{
  "schemaVersion": 1,
  "id": "copper_cauldron",
  "version": "${version}",
  "name": "Copper Cauldron",
  "description": "Adds a copper cauldron, used for various recipes",
  "authors": [
    "MattiDragon"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/copper-cauldron",
    "sources": "https://github.com/MattiDragon/CopperCauldron"
  },
  "license": "Apache-2.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.mattidragon.coppercauldron.CopperCauldron"
    ],
    "client": [
      "dev.mattidragon.coppercauldron.client.CopperCauldronClient"
    ]
  },
  "mixins": [
    "copper-cauldron.mixins.json",
    {
      "config": "copper-cauldron.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.21.8",
    "java": ">=21",
    "fabric-api": "*"
